# Copier ce fichier en `.env` et renseigner les valeurs.
#
# Fournisseur du modèle de langage :
# - openai : serveur OpenAI-compatible (LLM_BASE_URL + LLM_API_KEY)
# - gemini : même modèle via la Gemini Developer API de Google (GEMINI_API_KEY)
LLM_PROVIDER=openai
#
# Accès au modèle de langage (protocole OpenAI-compatible, LLM_PROVIDER=openai).
# - Aujourd'hui : serveur distant (URL + clé API Gemma fournies par teklia).
# - Bascule vers un modèle local : remplacer LLM_BASE_URL par l'URL du serveur
#   local (ex. http://localhost:8000/v1), mettre une clé factice dans
#   LLM_API_KEY si le serveur n'en exige pas, et ajuster LLM_MODEL au nom
#   du modèle exposé par le serveur local.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gemma-4-26B-A4B-it
#
# Clé de la Gemini Developer API (LLM_PROVIDER=gemini).
GEMINI_API_KEY=
# Modèles Google essayés si LLM_MODEL échoue (séparés par des virgules).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
